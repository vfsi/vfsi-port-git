#!/bin/sh
# Download a pinned SDK; its published installer owns Cargo/build/install policy.
set -eu

headers_only=0
case "$#" in
    0) ;;
    1) if test "$1" = --headers-only; then headers_only=1; else
           echo "usage: $0 [--headers-only]" >&2; exit 2
       fi ;;
    *) echo "usage: $0 [--headers-only]" >&2; exit 2 ;;
esac

VFSI_C_VERSION=0.3.15
VFSI_C_SHA256=7fb19f96ead278ba3f1c7c86fdcf46884752c1b47e6a85ebd605ef937ec54e43
root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
build_root=${VFSI_BUILD_DIR:-"$root/build-vfsi-c"}
release_root="$build_root/vfsi-c-$VFSI_C_VERSION"
archive="$release_root/vfsi-c-$VFSI_C_VERSION.crate"
source_dir="$release_root/source"
target_dir="$release_root/target"

report_headers() {
    test -f "$source_dir/include/vfsi.h" || {
        echo "$0: missing vfsi.h in $source_dir/include" >&2; exit 1
    }
    printf 'VFSI C header: %s/include/vfsi.h\n' "$source_dir"
    if test -n "${GITHUB_OUTPUT:-}"; then
        printf 'include=%s/include\n' "$source_dir" >>"$GITHUB_OUTPUT"
    fi
}

if test -n "${VFSI_SDK_SOURCE:-}"; then
    source_dir=$VFSI_SDK_SOURCE
    if test "$headers_only" = 1; then report_headers; exit 0; fi
    exec python3 "$source_dir/build-sdk.py" \
        --profile "${VFSI_SDK_PROFILE:-release}" --target-dir "${VFSI_SDK_TARGET:-$target_dir}" \
        --prefix "$release_root/sdk-dev"
fi

for tool in curl python3 tar; do
    command -v "$tool" >/dev/null 2>&1 || {
        echo "$0: required tool not found: $tool" >&2; exit 1
    }
done
mkdir -p "$release_root"
if test ! -f "$archive"; then
    curl --proto '=https' --tlsv1.2 -A "vfsi-port/$VFSI_C_VERSION" -fsSL \
        "https://crates.io/api/v1/crates/vfsi-c/$VFSI_C_VERSION/download" \
        -o "$archive.tmp"
    mv "$archive.tmp" "$archive"
fi
python3 - "$archive" "$VFSI_C_SHA256" <<'CHECKSUM'
import hashlib
from pathlib import Path
import sys
digest = hashlib.sha256()
with Path(sys.argv[1]).open("rb") as source:
    for chunk in iter(lambda: source.read(1024 * 1024), b""):
        digest.update(chunk)
if digest.hexdigest() != sys.argv[2]:
    raise SystemExit(f"checksum mismatch: {sys.argv[1]}")
CHECKSUM
if test ! -f "$source_dir/.vfsi-release"; then
    tmp_source="$release_root/source.tmp"
    rm -rf "$tmp_source"
    mkdir -p "$tmp_source"
    tar -xzf "$archive" --strip-components=1 -C "$tmp_source"
    printf '%s\n' "$VFSI_C_SHA256" >"$tmp_source/.vfsi-release"
    rm -rf "$source_dir"
    mv "$tmp_source" "$source_dir"
fi
if test "$headers_only" = 1; then report_headers; exit 0; fi
exec python3 "$source_dir/build-sdk.py" --registry-only \
    --target-dir "$target_dir" --prefix "$release_root/sdk"
